<?xml version="1.0" encoding="utf-8"?>
<!-- Dégradé assorti à l'app (Utils.blueGradientColors), orienté haut-droite → bas-gauche.
     darkBlue #1C3168 → intermédiaire #29497A → blue #294B79. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#294B79"
        android:centerColor="#29497A"
        android:endColor="#1C3168" />
    <corners android:radius="24dp" />
</shape>
